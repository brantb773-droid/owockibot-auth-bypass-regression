# Base URL of the API under test. Defaults to production if unset.
# Point this at a staging/local instance if you have one — that's the
# safer place to run this suite, especially the destructive tests.
BASE_URL=https://owockibot.xyz

# ---- Safety gates (see README "Safety design") ----
# Leave both unset / false by default. Only flip them on if you have
# explicit permission from owocki to run write-tests against this BASE_URL,
# or you're pointed at a non-production instance.

# Allows the comment-impersonation regression test to actually POST a
# comment if the bypass is still open. If true, the injected comment is a
# clearly-labeled, harmless test string (see tests/comments-bypass.test.js).
ALLOW_DESTRUCTIVE_COMMENT_TEST=false

# Enables the create-bounty auth test. Off by default because the
# create endpoint's exact shape is UNCONFIRMED (see README) — turn on only
# after you've verified POST /api/bounty-board's real request format.
ALLOW_CREATE_BOUNTY_TEST=false

# ---- Positive-path (valid signature) tests ----
# These need a wallet that's actually allowlisted on the target instance,
# and confirmation of the real nonce/SIWE endpoint shape. Leave blank to
# skip positive-path tests (they'll report as skipped, not failed).
TEST_WALLET_PRIVATE_KEY=
